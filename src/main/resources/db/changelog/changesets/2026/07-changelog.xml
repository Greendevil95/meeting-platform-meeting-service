<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="2026-07-31-add-keycloak-subject-to-user-read-model" author="Denis Bondarev">
        <addColumn tableName="user_read_model">
            <column name="keycloak_subject" type="varchar(64)"/>
        </addColumn>

        <addUniqueConstraint tableName="user_read_model"
                             columnNames="keycloak_subject"
                             constraintName="uk_user_read_model_keycloak_subject"/>
    </changeSet>

</databaseChangeLog>
